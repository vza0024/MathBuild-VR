# Copy this file to .env and fill in the values. Never commit .env.

# OpenAI API key. Leave empty to run with the mock LLM only.
OPENAI_API_KEY=

# Model and generation settings (logged with every request).
LLM_MODEL=gpt-6.1-sol
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=20
LLM_MAX_OUTPUT_TOKENS=400

# 1 = use the deterministic mock LLM (no API calls, no cost).
USE_MOCK_LLM=1

# Where research logs are written.
LOG_DIR=logs

# Prompt version for VR testing: step3-pov-v5 (final tuned POV-aware prompt).
# Older: step3-pov-v4, step3-pov-v3, step3-pov-v2, step1-v2 (code default), step1-v1.
PROMPT_VERSION=step3-pov-v5
